{% comment %}
  Unified skills entry renderer for both formats
{% endcomment %}

<div class="card-text font-weight-light">
  {% for entry in entries %}
    <div class="skill-item">
      {% if entry.icon %}
        <i class="{{ entry.icon }}"></i>
      {% endif %}
      {% assign skill_name = entry.name | default: entry.label %}
      {% assign skill_keywords = entry.keywords | default: entry.details %}
      <strong>
        {{- skill_name -}}
        {%- if entry.level %} ({{ entry.level }}){% endif %}:</strong
      >
      {% if skill_keywords %}
        {{ skill_keywords }}
      {% endif %}
    </div>
  {% endfor %}
</div>

<style>
  .skill-item {
    padding: 0.5rem 0;
  }
</style>
